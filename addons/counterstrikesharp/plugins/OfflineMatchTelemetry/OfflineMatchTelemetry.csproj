<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OfflineMatchTelemetry</AssemblyName>
    <RootNamespace>OfflineMatchTelemetry</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <Target Name="StageForGameDeploy" AfterTargets="Publish">
    <PropertyGroup>
      <StageBase>$(MSBuildProjectDirectory)\stage</StageBase>
      <StageDir>$(StageBase)\game\csgo\addons\counterstrikesharp\plugins\OfflineMatchTelemetry\</StageDir>
    </PropertyGroup>

    <RemoveDir Directories="$(StageBase)" />
    <MakeDir Directories="$(StageDir)" />

    <ItemGroup>
      <!-- CounterStrikeSharp provides its own framework and API assemblies. Ship only this
           plugin plus the SQLite provider's managed and Windows native dependencies. -->
      <StageFiles Include="
        $(PublishDir)\OfflineMatchTelemetry.dll;
        $(PublishDir)\OfflineMatchTelemetry.deps.json;
        $(PublishDir)\OfflineMatchTelemetry.pdb;
        $(PublishDir)\Microsoft.Data.Sqlite.dll;
        $(PublishDir)\SQLitePCLRaw.batteries_v2.dll;
        $(PublishDir)\SQLitePCLRaw.core.dll;
        $(PublishDir)\SQLitePCLRaw.provider.e_sqlite3.dll;
        $(PublishDir)\runtimes\win-x64\native\e_sqlite3.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(StageFiles)" DestinationFolder="$(StageDir)" />
    <Message Importance="high" Text="[Deploy ready] $(StageDir)" />
  </Target>
</Project>
