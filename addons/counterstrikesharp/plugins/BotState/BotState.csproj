<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared API contract. Deployed to CSS shared/, so don't copy it next to
         the plugin (Private=false) — both sides must load the one shared DLL. -->
    <ProjectReference Include="..\..\shared\BotControllerApi\BotControllerApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>